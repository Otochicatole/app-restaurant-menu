{
  "name": "app-res",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "clean:e2e": "bun -e \"import { rm } from 'node:fs/promises'; await rm('.next-e2e', { recursive: true, force: true })\"",
    "build:e2e": "bun run clean:e2e && cross-env NEXT_DIST_DIR=.next-e2e prisma generate && cross-env NEXT_DIST_DIR=.next-e2e next build",
    "start": "next start --hostname 0.0.0.0 --port 8201",
    "start:e2e": "cross-env NEXT_DIST_DIR=.next-e2e next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "architecture": "depcruise --config dependency-cruiser.cjs src",
    "db:migrate": "bun x prisma migrate dev",
    "db:generate": "bun x prisma generate",
    "db:seed": "bun x prisma db seed",
    "db:cutover": "bun run scripts/db-cutover.ts",
    "deploy:local": "bun run scripts/deploy-local.ts",
    "deploy:local:start": "bun run scripts/deploy-local.ts --serve",
    "storage:cleanup": "bun run scripts/drain-asset-cleanup.ts",
    "test": "bun x vitest run",
    "test:unit": "bun x vitest run src",
    "test:integration": "bun x vitest run tests/integration",
    "test:coverage": "bun x vitest run src --coverage",
    "test:migration-cutover": "bun run scripts/verify-legacy-upgrade.ts",
    "test:e2e": "bun x playwright test",
    "check": "bun run lint && bun run architecture && bun run typecheck && bun run test:unit && bun run build",
    "check:ci": "bun run scripts/run-ci-checks.ts",
    "db:studio": "bun x prisma studio"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "6.2.10",
    "konva": "^10.3.2",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "^19.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.0.0",
    "dependency-cruiser": "^17.3.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "nanoid": "3.3.18"
  }
}
