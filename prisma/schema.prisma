generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  TENANT_ADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Admin {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               AdminRole @default(TENANT_ADMIN)
  tenantId           String?   @unique
  tenant             Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  admin     Admin?
  homePage  HomePage?
  groups    Group[]
  fonts     Font[]
  settings  Setting[]
}

model Session {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  jti       String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Group {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] @relation("GroupProducts")

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model HomePage {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String   @default("Fuzion")
  description String   @default("Desayunos y meriendas")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String            @id @default(cuid())
  tenantId    String
  name        String
  description String            @default("")
  price       Float
  groupId     String
  sortOrder   Int               @default(0)
  mediaPath   String?
  mediaType   String?
  group       Group             @relation("GroupProducts", fields: [groupId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  featured    FeaturedProduct[] @relation("ProductFeatured")

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, groupId])
}

model FeaturedProduct {
  id        String   @id @default(cuid())
  tenantId  String
  position  Int
  productId String
  product   Product  @relation("ProductFeatured", fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, position])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Font {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  category     String
  source       String
  googleFamily String?
  fontFamily   String
  weights      String   @default("400;700")
  filePath     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Setting {
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([tenantId, key])
}
