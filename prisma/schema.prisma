generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AdminRole {
  SUPER_ADMIN
  TENANT_ADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Admin {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               AdminRole @default(TENANT_ADMIN)
  tenantId           String?   @unique
  tenant             Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  publicDescription String @default("Menú digital")
  assetQuotaBytes Int @default(262144000)
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  admin     Admin?
  homePage  HomePage?
  groups    Group[]
  fonts     Font[]
  settings  Setting[]
  menuProject MenuProject?
  menuAssets MenuAsset[]
  menuAssetReferences MenuAssetReference[]
}

model Session {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  jti       String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model LoginThrottle {
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

model AssetCleanupJob {
  id          String   @id @default(cuid())
  storageKey  String   @unique
  deletePrefix Boolean @default(false)
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([availableAt])
}

model Group {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] @relation("GroupProducts")

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model HomePage {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String   @default("Fuzion")
  description String   @default("Desayunos y meriendas")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String            @id @default(cuid())
  tenantId    String
  name        String
  description String            @default("")
  price       Float
  groupId     String
  sortOrder   Int               @default(0)
  mediaPath   String?
  mediaType   String?
  group       Group             @relation("GroupProducts", fields: [groupId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  featured    FeaturedProduct[] @relation("ProductFeatured")

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, groupId])
}

model FeaturedProduct {
  id        String   @id @default(cuid())
  tenantId  String
  position  Int
  productId String
  product   Product  @relation("ProductFeatured", fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, position])
  @@unique([tenantId, productId], map: "FeaturedProduct_tenant_product_key")
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Font {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  category     String
  source       String
  googleFamily String?
  fontFamily   String
  weights      String   @default("400;700")
  filePath     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Setting {
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([tenantId, key])
}

enum MenuAssetKind {
  IMAGE
  FONT
}

enum MenuAssetReferenceScope {
  DRAFT
  PUBLISHED
}

model MenuProject {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  draftJson         String
  draftRevision     Int      @default(0)
  publishedJson     String?
  publishedRevision Int?
  publishedAt       DateTime?
  schemaVersion     Int      @default(1)
  legacyFallback    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  assetReferences   MenuAssetReference[]

  @@unique([id, tenantId])
}

model MenuAsset {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind        MenuAssetKind
  name        String
  storageKey  String        @unique
  mimeType    String
  byteSize    Int
  checksum    String
  width       Int?
  height      Int?
  fontFamily  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  references  MenuAssetReference[]

  @@unique([id, tenantId])
  @@index([tenantId, kind])
}

model MenuAssetReference {
  tenantId  String
  projectId String
  assetId   String
  scope     MenuAssetReferenceScope
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   MenuProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  asset     MenuAsset   @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([projectId, assetId, scope])
  @@index([tenantId, scope])
}
