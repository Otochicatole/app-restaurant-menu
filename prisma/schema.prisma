generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Domain CHECK constraints live in the database_hardening SQL migration.
// Preserve them when future migrations rebuild SQLite tables.

enum AdminRole {
  SUPER_ADMIN
  TENANT_ADMIN
  WAITER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Admin {
  // SQL migrations preserve NOCASE email uniqueness and role/organization checks.
  id                 String        @id @default(cuid())
  email              String        @unique
  passwordHash       String
  role               AdminRole     @default(TENANT_ADMIN)
  organizationId     String?       @unique
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurantId       String?       @unique
  restaurant         Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  mustChangePassword Boolean       @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  sessions           Session[]
}

model Organization {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  status         TenantStatus @default(ACTIVE)
  maxRestaurants Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  admin          Admin?
  restaurants    Restaurant[]
}

model AppSchemaState {
  id            String   @id @default("singleton")
  generation    Int      @default(5)
  state         String   @default("READY")
  migrationJson String?
  updatedAt     DateTime @updatedAt
}

model Restaurant {
  id                           String                        @id @default(cuid())
  organizationId               String
  organization                 Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                         String
  publicDescription            String                        @default("Menú digital")
  assetQuotaBytes              Int                           @default(262144000)
  dailyReservationCapacity     Int                           @default(50)
  timeZone                     String                        @default("America/Argentina/Buenos_Aires")
  floorManagementEnabled       Boolean                       @default(false)
  reservationPreparationMinutes Int                           @default(15)
  reservationDurationMinutes    Int                           @default(120)
  slug                         String                        @unique
  landingSlug                  String                        @unique
  status                       TenantStatus                  @default(ACTIVE)
  landingEnabled               Boolean                       @default(false)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  landingPage                  LandingPage?
  landingCustomModules         LandingCustomModule[]
  landingTemplates             LandingTemplate[]
  menuProject                  MenuProject?
  menuAssets                   MenuAsset[]
  menuAssetReferences          MenuAssetReference[]
  menuTemplates                MenuTemplate[]
  menuTemplateAssetReferences  MenuTemplateAssetReference[]
  reservationTimeSlots         ReservationTimeSlot[]
  reservationRecurringClosures ReservationRecurringClosure[]
  reservationBlockedDates      ReservationBlockedDate[]
  restaurantEvents             RestaurantEvent[]
  tableReservations            TableReservation[]
  waiterAccount                Admin?
  diningRooms                  DiningRoom[]
  diningTables                 DiningTable[]
  diningTableCombinations      DiningTableCombination[]
  reservationAllocations       ReservationAllocation[]
  serviceProducts              ServiceProduct[]
  serviceCashEvents            ServiceCashEvent[]
  staffMembers                 RestaurantStaffMember[]

  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  jti       String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model LoginThrottle {
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

model AssetCleanupJob {
  id           String   @id @default(cuid())
  storageKey   String   @unique
  deletePrefix Boolean  @default(false)
  attempts     Int      @default(0)
  availableAt  DateTime @default(now())
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([availableAt])
}

enum MenuAssetKind {
  IMAGE
  VIDEO
  FONT
}

enum MenuAssetReferenceScope {
  DRAFT
  PUBLISHED
}

enum MenuTemplateVisibility {
  PRIVATE
  PUBLIC
}

enum MenuTemplateStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

model MenuProject {
  id                String               @id @default(cuid())
  restaurantId      String               @unique
  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name              String
  slug              String               @unique
  publicDescription String               @default("Menú digital")
  isPrimary         Boolean              @default(false)
  draftJson         String
  draftRevision     Int                  @default(0)
  publishedJson     String?
  publishedRevision Int?
  publishedAt       DateTime?
  schemaVersion     Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  assetReferences   MenuAssetReference[]

  @@unique([id, restaurantId])
}

model MenuAsset {
  id                 String                       @id @default(cuid())
  restaurantId       String
  restaurant         Restaurant                   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kind               MenuAssetKind
  name               String
  storageKey         String                       @unique
  mimeType           String
  byteSize           Int
  checksum           String
  width              Int?
  height             Int?
  fontFamily         String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  references         MenuAssetReference[]
  templateReferences MenuTemplateAssetReference[]

  @@unique([id, restaurantId])
  @@index([restaurantId, kind])
  @@index([restaurantId, checksum])
}

model MenuAssetReference {
  restaurantId String
  projectId    String
  assetId      String
  scope        MenuAssetReferenceScope
  restaurant   Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  project      MenuProject             @relation(fields: [projectId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  asset        MenuAsset               @relation(fields: [assetId, restaurantId], references: [id, restaurantId], onDelete: Cascade)

  @@id([projectId, assetId, scope])
  @@index([restaurantId, scope])
  @@index([restaurantId, assetId])
}

model MenuTemplate {
  id              String                       @id @default(cuid())
  restaurantId    String?
  restaurant      Restaurant?                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  description     String                       @default("")
  documentJson    String
  schemaVersion   Int                          @default(1)
  visibility      MenuTemplateVisibility       @default(PRIVATE)
  status          MenuTemplateStatus           @default(DRAFT)
  isSystem        Boolean                      @default(false)
  rejectionReason String?
  submittedAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  assets          MenuTemplateAsset[]
  references      MenuTemplateAssetReference[]

  @@unique([id, restaurantId])
  @@index([visibility, status])
  @@index([restaurantId, status])
}

model MenuTemplateAsset {
  id         String        @id @default(cuid())
  templateId String
  template   MenuTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  kind       MenuAssetKind
  name       String
  storageKey String        @unique
  mimeType   String
  byteSize   Int
  checksum   String
  width      Int?
  height     Int?
  fontFamily String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([templateId])
}

model MenuTemplateAssetReference {
  restaurantId String
  templateId   String
  assetId      String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  template     MenuTemplate @relation(fields: [templateId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  asset        MenuAsset    @relation(fields: [assetId, restaurantId], references: [id, restaurantId], onDelete: Cascade)

  @@id([templateId, assetId])
  @@index([restaurantId, assetId])
}

model LandingPage {
  id           String     @id @default(cuid())
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  documentJson String?
  htmlContent  String     @default("")
  cssContent   String     @default("")
  jsContent    String     @default("")
  published    Boolean    @default(false)
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model LandingCustomModule {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String     @default("")
  category     String     @default("custom")
  fieldsJson   String     @default("[]")
  htmlTemplate String     @default("")
  cssTemplate  String     @default("")
  jsTemplate   String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
}

model LandingTemplate {
  id              String                 @id @default(cuid())
  restaurantId    String?
  restaurant      Restaurant?            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  description     String                 @default("")
  documentJson    String
  htmlContent     String                 @default("")
  cssContent      String                 @default("")
  jsContent       String                 @default("")
  schemaVersion   Int                    @default(1)
  visibility      MenuTemplateVisibility @default(PRIVATE)
  status          MenuTemplateStatus     @default(DRAFT)
  isSystem        Boolean                @default(false)
  rejectionReason String?
  submittedAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([visibility, status])
  @@index([restaurantId, status])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

enum RestaurantEventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model ReservationTimeSlot {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  time         String
  label        String     @default("")
  active       Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, time])
  @@index([restaurantId, active])
}

model ReservationRecurringClosure {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  reason       String     @default("Cerrado por descanso semanal")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, dayOfWeek])
}

model ReservationBlockedDate {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  date         String
  reason       String     @default("Cerrado por fecha especial")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, date])
}

model RestaurantEvent {
  id                        String                @id @default(cuid())
  restaurantId              String
  restaurant                Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title                     String
  description               String                @default("")
  date                      String
  startTime                 String
  endTime                   String                @default("")
  capacity                  Int                   @default(20)
  priceLabel                String                @default("")
  imageUrl                  String                @default("")
  blocksRegularReservations Boolean               @default(false)
  status                    RestaurantEventStatus @default(PUBLISHED)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  reservations              TableReservation[]
  rooms                     RestaurantEventRoom[]

  @@unique([id, restaurantId])
  @@index([restaurantId, date, status])
}

model TableReservation {
  id            String            @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code          String
  customerName  String
  customerEmail String            @default("")
  customerPhone String
  partySize     Int               @default(2)
  date          String
  time          String
  notes         String            @default("")
  adminNotes    String            @default("")
  status        ReservationStatus @default(PENDING)
  source        String            @default("LANDING")
  eventId       String?
  event         RestaurantEvent?  @relation(fields: [eventId, restaurantId], references: [id, restaurantId], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  revision      Int               @default(0)
  allocation    ReservationAllocation?

  @@unique([id, restaurantId])
  @@unique([restaurantId, code])
  @@index([restaurantId, date, status])
  @@index([restaurantId, status])
  @@index([eventId])
}

enum DiningTableShape {
  SQUARE
  RECTANGLE
  CIRCLE
}

model DiningRoom {
  id            String @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  width         Float @default(1200)
  height        Float @default(800)
  fixturesJson  String @default("[]")
  revision      Int @default(0)
  active        Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tables        DiningTable[]
  combinations  DiningTableCombination[]
  locations     DiningRoomLocation[]
  events        RestaurantEventRoom[]
  allocations   ReservationAllocation[]

  @@unique([id, restaurantId])
  @@unique([restaurantId, name])
}

model DiningRoomLocation {
  id            String @id @default(cuid())
  restaurantId  String
  roomId        String
  room          DiningRoom @relation(fields: [roomId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  name          String
  x             Float
  y             Float
  width         Float
  height        Float
  rotation      Int @default(0)
  active        Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  allocations   ReservationAllocation[]

  @@unique([id, restaurantId, roomId])
  @@unique([roomId, name])
  @@index([restaurantId, roomId, active])
}

model DiningTable {
  id            String @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  roomId        String
  room          DiningRoom @relation(fields: [roomId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  label         String
  shape         DiningTableShape
  capacity      Int @default(4)
  x             Float
  y             Float
  width         Float @default(80)
  height        Float @default(80)
  rotation      Int @default(0)
  active        Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  combinationMembers DiningTableCombinationMember[]
  allocations   ReservationAllocationTable[]
  serviceAccounts ServiceAccountTable[]

  @@unique([id, restaurantId, roomId])
  @@unique([roomId, label])
  @@index([restaurantId, roomId, active])
}

model DiningTableCombination {
  id            String @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  roomId        String
  room          DiningRoom @relation(fields: [roomId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  name          String
  capacity      Int
  active        Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       DiningTableCombinationMember[]
  allocations   ReservationAllocation[]

  @@unique([id, restaurantId, roomId])
  @@unique([roomId, name])
}

model DiningTableCombinationMember {
  combinationId String
  tableId       String
  restaurantId  String
  roomId        String
  x             Float
  y             Float
  rotation      Int @default(0)
  combination   DiningTableCombination @relation(fields: [combinationId, restaurantId, roomId], references: [id, restaurantId, roomId], onDelete: Cascade)
  table         DiningTable @relation(fields: [tableId, restaurantId, roomId], references: [id, restaurantId, roomId], onDelete: Cascade)

  @@id([combinationId, tableId])
  @@index([restaurantId, tableId])
}

model RestaurantEventRoom {
  eventId       String
  roomId        String
  restaurantId  String
  event         RestaurantEvent @relation(fields: [eventId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  room          DiningRoom @relation(fields: [roomId, restaurantId], references: [id, restaurantId], onDelete: Cascade)

  @@id([eventId, roomId])
  @@index([restaurantId, roomId])
}

model ReservationAllocation {
  id             String @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservationId  String @unique
  reservation    TableReservation @relation(fields: [reservationId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  roomId         String
  room           DiningRoom @relation(fields: [roomId, restaurantId], references: [id, restaurantId], onDelete: NoAction)
  combinationId  String?
  combination    DiningTableCombination? @relation(fields: [combinationId, restaurantId, roomId], references: [id, restaurantId, roomId], onDelete: NoAction)
  locationId     String?
  location       DiningRoomLocation? @relation(fields: [locationId, restaurantId, roomId], references: [id, restaurantId, roomId], onDelete: NoAction)
  capacity       Int
  timeZone       String
  serviceStartAt DateTime
  serviceEndAt   DateTime
  blockedFrom    DateTime
  blockedUntil   DateTime
  releasedAt     DateTime?
  roomRevision   Int
  version        Int @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tables         ReservationAllocationTable[]
  serviceAccounts ServiceAccount[]

  @@unique([id, restaurantId, roomId])
  @@unique([id, restaurantId, reservationId, roomId])
  @@unique([reservationId, restaurantId])
  @@index([restaurantId, blockedFrom])
  @@index([restaurantId, roomId, blockedFrom])
  @@index([restaurantId, roomId, locationId, blockedFrom])
}

model ReservationAllocationTable {
  allocationId    String
  tableId         String
  restaurantId    String
  roomId          String
  labelSnapshot   String
  shapeSnapshot   DiningTableShape
  capacitySnapshot Int
  width           Float
  height          Float
  x               Float
  y               Float
  rotation        Int
  releasedAt      DateTime?
  allocation      ReservationAllocation @relation(fields: [allocationId, restaurantId, roomId], references: [id, restaurantId, roomId], onDelete: Cascade)
  table           DiningTable @relation(fields: [tableId, restaurantId, roomId], references: [id, restaurantId, roomId], onDelete: NoAction)

  @@id([allocationId, tableId])
  @@index([restaurantId, tableId, allocationId])
}

model ServiceProduct {
  id             String @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name           String
  unitPriceCents Int
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lines          ServiceOrderLine[]

  @@unique([id, restaurantId])
  @@index([restaurantId, active, name])
}

enum StaffRole {
  WAITER
  KITCHEN
  BAR
  CASHIER
  HOST
  MANAGER
  OTHER
}

model RestaurantStaffMember {
  id              String           @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  role            StaffRole        @default(WAITER)
  phone           String           @default("")
  notes           String           @default("")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  serviceAccounts ServiceAccount[]

  @@unique([id, restaurantId])
  @@index([restaurantId, active, role, name])
}

model ServiceAccount {
  id              String @id @default(cuid())
  restaurantId    String
  reservationId   String
  allocationId    String
  roomId          String
  allocation      ReservationAllocation @relation(fields: [allocationId, restaurantId, reservationId, roomId], references: [id, restaurantId, reservationId, roomId], onDelete: Restrict, onUpdate: Restrict)
  roomName        String
  reservationCode String
  customerName    String
  assignedWaiterId   String?
  assignedWaiterName String?
  assignedWaiter     RestaurantStaffMember? @relation(fields: [assignedWaiterId, restaurantId], references: [id, restaurantId], onDelete: NoAction, onUpdate: Cascade)
  version         Int @default(0)
  openedAt        DateTime @default(now())
  openedBy        String
  closedAt        DateTime?
  closedBy        String?
  businessDate    String?
  paymentMethod   String?
  totalCents      Int?
  receiptNumber   String?
  tipCents        Int     @default(0)
  discountCents   Int     @default(0)
  discountReason  String?
  cashCents       Int     @default(0)
  cardCents       Int     @default(0)
  transferCents   Int     @default(0)
  tables          ServiceAccountTable[]
  lines           ServiceOrderLine[]

  @@unique([id, restaurantId])
  @@unique([id, restaurantId, roomId])
  @@unique([restaurantId, receiptNumber])
  @@index([restaurantId, closedAt])
  @@index([restaurantId, businessDate, closedAt])
  @@index([allocationId, closedAt])
  @@index([restaurantId, assignedWaiterId])
}

model ServiceAccountTable {
  accountId    String
  restaurantId String
  roomId       String
  tableId      String
  label        String
  releasedAt   DateTime?
  account      ServiceAccount @relation(fields: [accountId, restaurantId, roomId], references: [id, restaurantId, roomId], onDelete: Cascade)
  table        DiningTable @relation(fields: [tableId, restaurantId, roomId], references: [id, restaurantId, roomId], onDelete: Restrict, onUpdate: Restrict)

  @@id([accountId, tableId])
  @@index([restaurantId, tableId])
}

model ServiceOrderLine {
  id                String @id @default(cuid())
  accountId         String
  restaurantId      String
  productId         String?
  account           ServiceAccount @relation(fields: [accountId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  product           ServiceProduct? @relation(fields: [productId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  name              String
  unitPriceCents    Int
  quantity          Int
  deliveredQuantity Int @default(0)
  cancelledQuantity Int @default(0)
  createdAt         DateTime @default(now())
  notes             String   @default("")
  kitchenStatus     String   @default("PENDING")
  round             Int      @default(1)
  station           String   @default("KITCHEN")

  @@index([accountId, createdAt])
}

model ServiceCashEvent {
  id            String @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  businessDate  String
  revision      Int
  kind          String
  actorId       String
  reason        String?
  createdAt     DateTime @default(now())
  cashCents     Int @default(0)
  cardCents     Int @default(0)
  transferCents Int @default(0)
  receiptCount  Int @default(0)

  @@unique([restaurantId, businessDate, revision])
}
