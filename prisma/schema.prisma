generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AdminRole {
  SUPER_ADMIN
  TENANT_ADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Admin {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               AdminRole @default(TENANT_ADMIN)
  tenantId           String?   @unique
  tenant             Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  publicDescription String @default("Menú digital")
  assetQuotaBytes Int @default(262144000)
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  admin     Admin?
  menuProject MenuProject?
  menuAssets MenuAsset[]
  menuAssetReferences MenuAssetReference[]
}

model Session {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  jti       String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model LoginThrottle {
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

model AssetCleanupJob {
  id          String   @id @default(cuid())
  storageKey  String   @unique
  deletePrefix Boolean @default(false)
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([availableAt])
}

enum MenuAssetKind {
  IMAGE
  FONT
}

enum MenuAssetReferenceScope {
  DRAFT
  PUBLISHED
}

model MenuProject {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  draftJson         String
  draftRevision     Int      @default(0)
  publishedJson     String?
  publishedRevision Int?
  publishedAt       DateTime?
  schemaVersion     Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  assetReferences   MenuAssetReference[]

  @@unique([id, tenantId])
}

model MenuAsset {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind        MenuAssetKind
  name        String
  storageKey  String        @unique
  mimeType    String
  byteSize    Int
  checksum    String
  width       Int?
  height      Int?
  fontFamily  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  references  MenuAssetReference[]

  @@unique([id, tenantId])
  @@index([tenantId, kind])
}

model MenuAssetReference {
  tenantId  String
  projectId String
  assetId   String
  scope     MenuAssetReferenceScope
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   MenuProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  asset     MenuAsset   @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([projectId, assetId, scope])
  @@index([tenantId, scope])
}
