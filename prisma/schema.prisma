generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AdminRole {
  SUPER_ADMIN
  TENANT_ADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Admin {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               AdminRole @default(TENANT_ADMIN)
  tenantId           String?   @unique
  tenant             Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  publicDescription String @default("Menú digital")
  assetQuotaBytes Int @default(262144000)
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  multiMenuEnabled Boolean @default(false)
  maxMenus  Int          @default(1)
  landingEnabled Boolean @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  admin     Admin?
  landingPage LandingPage?
  landingCustomModules LandingCustomModule[]
  landingTemplates LandingTemplate[]
  menuProjects MenuProject[]
  menuAssets MenuAsset[]
  menuAssetReferences MenuAssetReference[]
  menuTemplates MenuTemplate[]
  menuTemplateAssetReferences MenuTemplateAssetReference[]
  reservationTimeSlots ReservationTimeSlot[]
  reservationRecurringClosures ReservationRecurringClosure[]
  reservationBlockedDates ReservationBlockedDate[]
  restaurantEvents RestaurantEvent[]
  tableReservations TableReservation[]
}

model Session {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  jti       String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model LoginThrottle {
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

model AssetCleanupJob {
  id          String   @id @default(cuid())
  storageKey  String   @unique
  deletePrefix Boolean @default(false)
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([availableAt])
}

enum MenuAssetKind {
  IMAGE
  VIDEO
  FONT
}

enum MenuAssetReferenceScope {
  DRAFT
  PUBLISHED
}

enum MenuTemplateVisibility {
  PRIVATE
  PUBLIC
}

enum MenuTemplateStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

model MenuProject {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  slug              String   @unique
  publicDescription String   @default("Menú digital")
  isPrimary         Boolean  @default(false)
  draftJson         String
  draftRevision     Int      @default(0)
  publishedJson     String?
  publishedRevision Int?
  publishedAt       DateTime?
  schemaVersion     Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  assetReferences   MenuAssetReference[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, isPrimary])
}

model MenuAsset {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind        MenuAssetKind
  name        String
  storageKey  String        @unique
  mimeType    String
  byteSize    Int
  checksum    String
  width       Int?
  height      Int?
  fontFamily  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  references  MenuAssetReference[]
  templateReferences MenuTemplateAssetReference[]

  @@unique([id, tenantId])
  @@index([tenantId, kind])
}

model MenuAssetReference {
  tenantId  String
  projectId String
  assetId   String
  scope     MenuAssetReferenceScope
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   MenuProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  asset     MenuAsset   @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([projectId, assetId, scope])
  @@index([tenantId, scope])
}

model MenuTemplate {
  id           String                @id @default(cuid())
  tenantId     String?
  tenant       Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String                @default("")
  documentJson String
  schemaVersion Int                  @default(1)
  visibility   MenuTemplateVisibility @default(PRIVATE)
  status       MenuTemplateStatus    @default(DRAFT)
  isSystem     Boolean               @default(false)
  rejectionReason String?
  submittedAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  assets       MenuTemplateAsset[]
  references   MenuTemplateAssetReference[]

  @@index([visibility, status])
  @@index([tenantId, status])
}

model MenuTemplateAsset {
  id          String        @id @default(cuid())
  templateId  String
  template    MenuTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  kind        MenuAssetKind
  name        String
  storageKey  String        @unique
  mimeType    String
  byteSize    Int
  checksum    String
  width       Int?
  height      Int?
  fontFamily  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model MenuTemplateAssetReference {
  tenantId   String
  templateId String
  assetId    String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   MenuTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  asset      MenuAsset    @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([templateId, assetId])
  @@index([tenantId, assetId])
}

model LandingPage {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentJson String?
  htmlContent  String    @default("")
  cssContent   String    @default("")
  jsContent    String    @default("")
  published    Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
}

model LandingCustomModule {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String   @default("")
  category     String   @default("custom")
  fieldsJson   String   @default("[]")
  htmlTemplate String   @default("")
  cssTemplate  String   @default("")
  jsTemplate   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model LandingTemplate {
  id              String                 @id @default(cuid())
  tenantId        String?
  tenant          Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String                 @default("")
  documentJson    String
  htmlContent     String                 @default("")
  cssContent      String                 @default("")
  jsContent       String                 @default("")
  schemaVersion   Int                    @default(1)
  visibility      MenuTemplateVisibility @default(PRIVATE)
  status          MenuTemplateStatus     @default(DRAFT)
  isSystem        Boolean                @default(false)
  rejectionReason String?
  submittedAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([visibility, status])
  @@index([tenantId, status])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

enum RestaurantEventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model ReservationTimeSlot {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  time      String
  label     String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, time])
  @@index([tenantId, active])
}

model ReservationRecurringClosure {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  reason    String   @default("Cerrado por descanso semanal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model ReservationBlockedDate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      String
  reason    String   @default("Cerrado por fecha especial")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId, date])
}

model RestaurantEvent {
  id                        String                @id @default(cuid())
  tenantId                  String
  tenant                    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title                     String
  description               String                @default("")
  date                      String
  startTime                 String
  endTime                   String                @default("")
  capacity                  Int                   @default(20)
  priceLabel                String                @default("")
  imageUrl                  String                @default("")
  blocksRegularReservations Boolean               @default(false)
  status                    RestaurantEventStatus @default(PUBLISHED)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  reservations              TableReservation[]

  @@index([tenantId, date, status])
}

model TableReservation {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  customerName  String
  customerEmail String            @default("")
  customerPhone String
  partySize     Int               @default(2)
  date          String
  time          String
  notes         String            @default("")
  adminNotes    String            @default("")
  status        ReservationStatus @default(PENDING)
  source        String            @default("LANDING")
  eventId       String?
  event         RestaurantEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tenantId, date, status])
  @@index([tenantId, status])
  @@index([eventId])
}
