# En producción, ambas rutas deben ser absolutas. Ajustalas al APP_RELEASE_ROOT real.
DATABASE_URL=file:/opt/app-res/shared/database/app.db
# Archivo SQLite descartable y exclusivo para integración/E2E.
TEST_DATABASE_URL=file:/tmp/app-restaurant-menu-e2e/app-e2e.db
JWT_SECRET=replace-with-at-least-32-random-characters
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=replace-with-at-least-12-characters
APP_URL=http://localhost:3000
STORAGE_ROOT=/opt/app-res/shared/storage
# Activar sólo cuando la app no sea accesible directamente y el proxy sanee Forwarded/X-Forwarded-*.
TRUST_PROXY=false
